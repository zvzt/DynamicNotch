{
  "manifest_version": 2,
  "name": "DynamicNotch Media Bridge",
  "version": "1.1.1",
  "description": "Feeds Firefox now-playing metadata and artwork to DynamicNotch.",
  "applications": {"gecko": {"id": "dynamicnotch@zxt.local"}},
  "permissions": ["nativeMessaging", "tabs", "<all_urls>"],
  "background": {"scripts": ["background.js"]},
  "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle"}]
}